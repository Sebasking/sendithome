<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title
      default="SendItHome · Find your Caribbean shipper"
      suffix=" · SendItHome"
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <meta :if={assigns[:noindex]} name="robots" content="noindex, nofollow" />
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />
    <meta :if={assigns[:page_title]} property="og:title" content={@page_title} />
    <meta :if={assigns[:meta_description]} property="og:description" content={@meta_description} />
    <meta :if={assigns[:canonical_url]} property="og:url" content={@canonical_url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SendItHome" />
    <meta name="theme-color" content="#0E6B6B" />
    <link rel="icon" href={Brand.asset("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={Brand.asset("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={Brand.asset("apple-touch-icon.png")} />
    <script :if={assigns[:json_ld]} type="application/ld+json">
      <%= raw(Jason.encode!(@json_ld, escape: :html_safe)) %>
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <.theme_script />
  </head>
  <body>
    {@inner_content}
  </body>
</html>
