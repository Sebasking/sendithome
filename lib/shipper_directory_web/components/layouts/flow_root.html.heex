<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- No csrf-token: the flow sets no cookies, so it connects to the session-less socket --%>
    <meta name="live-socket-path" content="/flow/live" />
    <.live_title
      default="SendItHome · Find your Caribbean shipper"
      suffix=" · SendItHome"
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />
    <meta :if={assigns[:page_title]} property="og:title" content={@page_title} />
    <meta :if={assigns[:canonical_url]} property="og:url" content={@canonical_url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SendItHome" />
    <meta name="theme-color" content="#0E6B6B" />
    <link rel="icon" href={Brand.asset("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={Brand.asset("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={Brand.asset("apple-touch-icon.png")} />
    <link
      rel="preload"
      href={~p"/fonts/outfit-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <.theme_script />
  </head>
  <%!-- .flow-page switches the brand tokens to their dark values in dark mode (app.css) --%>
  <body class="flow-page bg-brand-ground">
    {@inner_content}
  </body>
</html>
