<Layouts.app flash={@flash}>
  <.header>
    Caribbean barrel &amp; freight shippers
    <:subtitle>
      Shippers with a verified, working website. Search by metro, island, and service is coming soon.
    </:subtitle>
  </.header>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div
      :for={company <- @companies}
      class="rounded-box border border-base-300 p-5 transition hover:shadow-md"
    >
      <h2 class="font-semibold">{company.name}</h2>
      <p :if={company.origin_metros != []} class="text-sm opacity-70">
        From {Enum.join(company.origin_metros, ", ")}{if company.state, do: ", #{company.state}"}
      </p>
      <p :if={company.destinations != []} class="mt-2 text-sm">
        To {Enum.join(company.destinations, ", ")}
      </p>
      <p :if={company.phone} class="mt-2 text-sm">{company.phone}</p>
      <a
        href={company.website_url}
        target="_blank"
        rel="noopener"
        class="link link-primary mt-3 inline-block text-sm"
      >
        Visit website
      </a>
    </div>
  </div>

  <p :if={@companies == []} class="opacity-70">No published shippers yet.</p>
</Layouts.app>
